
/* =========================================
   RESET
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #0b0b0b;
    color: #f5f5f5;

    font-family: "DM Sans", sans-serif;

    overflow-x: hidden;
}

img {
    width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: inherit;
}


/* =========================================
   CORES
========================================= */

:root {

    --gold: #d6a354;
    --gold-light: #efc77c;

    --black: #0b0b0b;
    --dark: #121212;
    --dark-2: #181818;

    --white: #f5f5f5;
    --gray: #a5a5a5;
    --border: rgba(255,255,255,0.10);
}


/* =========================================
   NAVBAR
========================================= */

.navbar {

    position: fixed;

    top: 0;
    left: 0;

    width: 100%;

    height: 80px;

    padding: 0 7%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    z-index: 999;

    background: rgba(11,11,11,0.75);

    backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(255,255,255,0.06);

    animation: fadeDown 1s ease;
}

.logo,
.footer-logo {

    font-family: "Playfair Display", serif;

    font-size: 25px;

    font-weight: 700;

    letter-spacing: 1px;
}

.logo span,
.footer-logo span {

    color: var(--gold);
}

nav {

    display: flex;

    gap: 32px;
}

nav a {

    color: #c9c9c9;

    font-size: 14px;

    transition: 0.3s;
}

nav a:hover {

    color: var(--gold);

    transform: translateY(-2px);
}

.nav-button {

    border: 1px solid var(--gold);

    color: var(--gold);

    padding: 10px 20px;

    border-radius: 50px;

    font-size: 13px;

    transition: 0.3s;
}

.nav-button:hover {

    background: var(--gold);

    color: #111;

    transform: translateY(-3px);
}


/* =========================================
   HERO
========================================= */

.hero {

    min-height: 100vh;

    position: relative;

    display: flex;

    align-items: center;

    padding: 140px 8%;

    background-image:
        url("https://images.unsplash.com/photo-1515003197210-e0cd71810b5f?auto=format&fit=crop&w=2000&q=90");

    background-size: cover;

    background-position: center;

    background-attachment: fixed;
}

.hero-overlay {

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,0.90),
            rgba(0,0,0,0.55),
            rgba(0,0,0,0.30)
        );
}

.hero-content {

    position: relative;

    z-index: 2;

    max-width: 760px;

    animation: heroUp 1.2s ease;
}

.badge {

    display: inline-block;

    color: var(--gold);

    font-size: 12px;

    letter-spacing: 4px;

    font-weight: 700;

    margin-bottom: 25px;
}

.hero h1 {

    font-family: "Playfair Display", serif;

    font-size: clamp(55px, 8vw, 100px);

    line-height: 0.98;

    font-weight: 600;

    margin-bottom: 30px;
}

.hero h1 span {

    display: block;

    color: var(--gold);
}

.hero-content > p {

    max-width: 530px;

    color: #d0d0d0;

    font-size: 18px;

    line-height: 1.7;

    margin-bottom: 38px;
}


/* =========================================
   BOTÕES
========================================= */

.hero-buttons {

    display: flex;

    gap: 15px;

    flex-wrap: wrap;
}

.button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 52px;

    padding: 0 25px;

    border-radius: 8px;

    font-size: 14px;

    font-weight: 700;

    transition:
        transform 0.3s,
        box-shadow 0.3s,
        background 0.3s;
}

.button:hover {

    transform: translateY(-5px);
}

.button-gold {

    background: var(--gold);

    color: #111;

    box-shadow: 0 12px 35px rgba(214,163,84,0.16);
}

.button-gold:hover {

    background: var(--gold-light);

    box-shadow: 0 18px 45px rgba(214,163,84,0.25);
}

.button-outline {

    border: 1px solid rgba(255,255,255,0.35);

    color: white;

    background: rgba(0,0,0,0.15);

    backdrop-filter: blur(5px);
}

.button-outline:hover {

    background: white;

    color: #111;
}


/* =========================================
   SCROLL
========================================= */

.scroll {

    position: absolute;

    bottom: 30px;

    left: 8%;

    display: flex;

    align-items: center;

    gap: 12px;

    color: #aaa;

    font-size: 10px;

    letter-spacing: 3px;
}

.scroll div {

    width: 50px;

    height: 1px;

    background: var(--gold);

    animation: scrollMove 1.8s infinite;
}


/* =========================================
   SEÇÕES
========================================= */

.section {

    max-width: 1200px;

    margin: auto;

    padding: 130px 7%;
}

.section-label {

    color: var(--gold);

    font-size: 11px;

    letter-spacing: 4px;

    font-weight: 700;

    display: block;

    margin-bottom: 20px;
}

h2 {

    font-family: "Playfair Display", serif;

    font-size: clamp(40px, 5vw, 65px);

    line-height: 1.05;

    font-weight: 600;
}

h2 span {

    color: var(--gold);
}

.line {

    width: 60px;

    height: 1px;

    background: var(--gold);

    margin: 35px 0;
}


/* =========================================
   SOBRE
========================================= */

.about {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 80px;

    align-items: center;
}

.about-image {

    position: relative;

    border-radius: 15px;

    overflow: hidden;
}

.about-image img {

    height: 600px;

    object-fit: cover;

    transition: 0.8s;
}

.about-image:hover img {

    transform: scale(1.06);
}

.image-label {

    position: absolute;

    bottom: 25px;

    left: 25px;

    padding: 18px 22px;

    background: rgba(0,0,0,0.75);

    backdrop-filter: blur(10px);

    border-left: 2px solid var(--gold);
}

.image-label strong {

    display: block;

    font-family: "Playfair Display", serif;

    font-size: 18px;
}

.image-label span {

    display: block;

    color: #aaa;

    font-size: 12px;

    margin-top: 3px;
}

.about-content h2 {

    margin-bottom: 30px;
}

.about-content > p {

    color: var(--gray);

    line-height: 1.9;

    margin-bottom: 15px;
}

.about-details {

    display: flex;

    gap: 50px;
}

.about-details div {

    display: flex;

    flex-direction: column;
}

.about-details strong {

    color: var(--gold);

    font-family: "Playfair Display", serif;

    font-size: 25px;
}

.about-details span {

    color: #777;

    font-size: 12px;

    margin-top: 5px;
}


/* =========================================
   EXPERIÊNCIA
========================================= */

.experience {

    max-width: none;

    background: var(--dark);

    text-align: center;
}

.section-heading {

    max-width: 700px;

    margin: auto auto 60px;
}

.section-heading h2 {

    margin-bottom: 20px;
}

.section-heading p {

    color: var(--gray);

    line-height: 1.7;
}

.cards {

    max-width: 1100px;

    margin: auto;

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;

    text-align: left;
}

.card {

    position: relative;

    padding: 40px;

    background: var(--dark-2);

    border: 1px solid var(--border);

    border-radius: 14px;

    overflow: hidden;

    transition: 0.4s;
}

.card:hover {

    transform: translateY(-12px);

    border-color: rgba(214,163,84,0.5);

    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
}

.card-number {

    position: absolute;

    top: 20px;

    right: 25px;

    color: #333;

    font-size: 14px;

    font-weight: 700;
}

.card-icon {

    font-size: 40px;

    margin-bottom: 25px;
}

.card h3 {

    font-family: "Playfair Display", serif;

    font-size: 27px;

    margin-bottom: 15px;
}

.card p {

    color: #888;

    line-height: 1.7;

    font-size: 14px;
}


/* =========================================
   GALERIA
========================================= */

.gallery {

    padding: 120px 7%;

    background: #0e0e0e;
}

.gallery-title {

    max-width: 1200px;

    margin: auto auto 50px;
}

.gallery-grid {

    max-width: 1200px;

    margin: auto;

    display: grid;

    grid-template-columns: 2fr 1fr 1fr;

    gap: 15px;
}

.gallery-item {

    height: 360px;

    overflow: hidden;

    border-radius: 10px;
}

.gallery-item.large {

    height: 360px;
}

.gallery-item img {

    height: 100%;

    object-fit: cover;

    transition: 0.7s;
}

.gallery-item:hover img {

    transform: scale(1.08);
}

.gallery-note {

    max-width: 1200px;

    margin: 20px auto 0;

    color: #555;

    font-size: 11px;
}


/* =========================================
   HORÁRIOS
========================================= */

.hours {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 80px;

    align-items: center;
}

.hours > div:first-child p {

    color: var(--gray);

    margin-top: 25px;
}

.hours-box {

    background: #151515;

    border-radius: 15px;

    padding: 10px 30px;

    border: 1px solid var(--border);
}

.hours-row {

    display: flex;

    justify-content: space-between;

    gap: 20px;

    padding: 25px 0;

    border-bottom: 1px solid #2a2a2a;
}

.hours-row:last-child {

    border-bottom: none;
}

.hours-row span {

    color: #aaa;
}

.hours-row strong {

    color: var(--gold);
}

.hours-row .closed {

    color: #777;
}


/* =========================================
   LOCALIZAÇÃO
========================================= */

.location {

    min-height: 600px;

    display: flex;

    align-items: center;

    padding: 100px 8%;

    background:
        linear-gradient(
            rgba(0,0,0,0.78),
            rgba(0,0,0,0.88)
        ),
        url("https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=2000&q=85");

    background-size: cover;

    background-position: center;
}

.location-content {

    max-width: 600px;
}

.location-content h2 {

    margin-bottom: 25px;
}

.location-content p {

    color: #ccc;

    line-height: 2;

    margin-bottom: 30px;
}


/* =========================================
   CONTATO
========================================= */

.contact {

    text-align: center;
}

.contact h2 {

    margin-bottom: 20px;
}

.contact > p {

    color: #888;

    margin-bottom: 30px;
}

.phone {

    display: inline-block;

    color: white;

    font-family: "Playfair Display", serif;

    font-size: clamp(30px, 5vw, 50px);

    margin-bottom: 30px;

    transition: 0.3s;
}

.phone:hover {

    color: var(--gold);
}


/* =========================================
   FOOTER
========================================= */

footer {

    padding: 60px 7%;

    background: #060606;

    text-align: center;
}

.footer-logo {

    margin-bottom: 15px;
}

footer p {

    color: #666;

    font-size: 13px;
}

.footer-line {

    width: 60px;

    height: 1px;

    background: #292929;

    margin: 30px auto;
}

footer small {

    color: #444;

    font-size: 11px;
}


/* =========================================
   ANIMAÇÕES
========================================= */

@keyframes fadeDown {

    from {

        opacity: 0;

        transform: translateY(-20px);
    }

    to {

        opacity: 1;

        transform: translateY(0);
    }
}

@keyframes heroUp {

    from {

        opacity: 0;

        transform: translateY(50px);
    }

    to {

        opacity: 1;

        transform: translateY(0);
    }
}

@keyframes scrollMove {

    0% {

        transform: scaleX(0.3);

        transform-origin: left;
    }

    50% {

        transform: scaleX(1);
    }

    100% {

        transform: scaleX(0.3);

        transform-origin: right;
    }
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 900px) {

    nav {

        gap: 15px;
    }

    .about {

        grid-template-columns: 1fr;

        gap: 50px;
    }

    .about-image img {

        height: 500px;
    }

    .cards {

        grid-template-columns: 1fr;
    }

    .hours {

        grid-template-columns: 1fr;

        gap: 40px;
    }

    .gallery-grid {

        grid-template-columns: 1fr 1fr;
    }

    .gallery-item.large {

        grid-column: span 2;
    }
}


/* =========================================
   CELULAR
========================================= */

@media (max-width: 650px) {

    .navbar {

        height: 70px;

        padding: 0 5%;
    }

    nav {

        display: none;
    }

    .nav-button {

        padding: 9px 16px;
    }

    .hero {

        min-height: 100svh;

        padding: 120px 7% 80px;

        background-attachment: scroll;

        background-position: 60% center;
    }

    .hero h1 {

        font-size: 54px;
    }

    .hero-content > p {

        font-size: 16px;
    }

    .hero-buttons {

        flex-direction: column;

        align-items: stretch;
    }

    .button {

        width: 100%;
    }

    .scroll {

        display: none;
    }

    .section {

        padding: 90px 7%;
    }

    .about-image img {

        height: 420px;
    }

    .about-details {

        gap: 25px;

        flex-wrap: wrap;
    }

    h2 {

        font-size: 42px;
    }

    .card {

        padding: 30px;
    }

    .gallery {

        padding: 90px 5%;
    }

    .gallery-grid {

        grid-template-columns: 1fr;
    }

    .gallery-item,
    .gallery-item.large {

        height: 280px;

        grid-column: auto;
    }

    .hours-box {

        padding: 10px 20px;
    }

    .hours-row {

        flex-direction: column;

        gap: 8px;
    }

    .location {

        min-height: 550px;

        padding: 90px 7%;
    }

    footer {

        padding: 45px 7%;
    }
}
