/* =========================================
   RESET
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #120b08;
    color: #fff8ed;
    font-family: "DM Sans", sans-serif;
    overflow-x: hidden;
}

img {
    width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: inherit;
}


/* =========================================
   VARIÁVEIS
========================================= */

:root {

    --gold: #d6a354;
    --gold-light: #f0c77c;

    --cream: #fff4df;

    --black: #120b08;
    --dark: #1a0f0b;
    --dark-2: #24140e;
    --brown: #321b11;

    --text: #fff8ed;
    --gray: #b9aaa0;

    --border: rgba(255,255,255,0.10);
}


/* =========================================
   NAVBAR
========================================= */

.navbar {

    position: fixed;

    top: 0;
    left: 0;

    width: 100%;
    height: 78px;

    padding: 0 6%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    z-index: 999;

    background: rgba(18,11,8,0.82);

    backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(214,163,84,0.12);

    animation: navbarDown 1s ease;
}

.logo {

    font-family: "Playfair Display", serif;

    font-size: 21px;

    font-weight: 800;

    letter-spacing: 1px;
}

.logo span {
    color: var(--gold);
}

nav {

    display: flex;

    gap: 30px;
}

nav a {

    color: #d4c8bd;

    font-size: 13px;

    transition: 0.3s;
}

nav a:hover {

    color: var(--gold);

    transform: translateY(-2px);
}

.nav-button {

    padding: 11px 22px;

    border: 1px solid var(--gold);

    border-radius: 50px;

    color: var(--gold);

    font-size: 13px;

    font-weight: 700;

    transition: 0.3s;
}

.nav-button:hover {

    background: var(--gold);

    color: #160d08;

    transform: translateY(-3px);
}


/* =========================================
   HERO
========================================= */

.hero {

    min-height: 100vh;

    position: relative;

    display: flex;

    align-items: center;

    padding: 150px 8% 100px;

    background-image:
        url("https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=2200&q=90");

    background-size: cover;

    background-position: center;
}

.hero-overlay {

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(18,8,4,0.95),
            rgba(18,8,4,0.72),
            rgba(18,8,4,0.25)
        );
}

.hero-content {

    position: relative;

    z-index: 2;

    max-width: 780px;

    animation: heroUp 1.2s ease;
}

.badge {

    display: inline-block;

    margin-bottom: 25px;

    color: var(--gold);

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 4px;
}

.hero h1 {

    font-family: "Playfair Display", serif;

    font-size: clamp(55px, 8vw, 100px);

    line-height: 0.95;

    font-weight: 700;

    margin-bottom: 30px;
}

.hero h1 span {

    display: block;

    color: var(--gold);
}

.hero-content > p {

    max-width: 540px;

    color: #ddd0c5;

    font-size: 18px;

    line-height: 1.8;

    margin-bottom: 35px;
}


/* =========================================
   BOTÕES
========================================= */

.hero-buttons {

    display: flex;

    gap: 14px;

    flex-wrap: wrap;
}

.button {

    min-height: 52px;

    padding: 0 25px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    border-radius: 8px;

    font-size: 14px;

    font-weight: 700;

    transition:
        transform 0.3s,
        box-shadow 0.3s,
        background 0.3s;
}

.button:hover {

    transform: translateY(-5px);
}

.button-gold {

    background: var(--gold);

    color: #1a0d06;

    box-shadow:
        0 12px 35px rgba(214,163,84,0.20);
}

.button-gold:hover {

    background: var(--gold-light);

    box-shadow:
        0 18px 45px rgba(214,163,84,0.30);
}

.button-outline {

    border: 1px solid rgba(255,255,255,0.35);

    color: white;

    background: rgba(0,0,0,0.15);

    backdrop-filter: blur(5px);
}

.button-outline:hover {

    background: white;

    color: #1a0d06;
}


/* =========================================
   HERO INFO
========================================= */

.hero-info {

    display: flex;

    gap: 45px;

    margin-top: 60px;

    padding-top: 25px;

    border-top: 1px solid rgba(255,255,255,0.15);
}

.hero-info div {

    display: flex;

    flex-direction: column;

    gap: 4px;
}

.hero-info strong {

    font-family: "Playfair Display", serif;

    color: var(--gold);

    font-size: 24px;
}

.hero-info span {

    color: #9f938a;

    font-size: 11px;

    text-transform: uppercase;

    letter-spacing: 1px;
}

.hero-decoration {

    position: absolute;

    right: 7%;

    bottom: 10%;

    z-index: 2;

    width: 180px;

    height: 180px;

    border: 1px solid rgba(214,163,84,0.45);

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    animation: rotateSlow 18s linear infinite;
}

.hero-decoration span {

    font-family: "Playfair Display", serif;

    color: var(--gold);

    font-size: 13px;

    letter-spacing: 4px;
}


/* =========================================
   SEÇÕES
========================================= */

.section {

    max-width: 1250px;

    margin: auto;

    padding: 130px 7%;
}

.section-label {

    display: block;

    color: var(--gold);

    font-size: 10px;

    font-weight: 700;

    letter-spacing: 4px;

    margin-bottom: 20px;
}

h2 {

    font-family: "Playfair Display", serif;

    font-size: clamp(42px, 5vw, 68px);

    line-height: 1.05;

    font-weight: 700;
}

h2 span {
    color: var(--gold);
}


/* =========================================
   SOBRE
========================================= */

.about {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 90px;

    align-items: center;
}

.about-image {

    position: relative;

    overflow: hidden;

    border-radius: 14px;
}

.about-image img {

    height: 600px;

    object-fit: cover;

    transition: 0.8s;
}

.about-image:hover img {

    transform: scale(1.06);
}

.image-badge {

    position: absolute;

    left: 25px;
    bottom: 25px;

    width: 100px;
    height: 100px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    background: var(--gold);

    color: #1b0e07;

    border-radius: 50%;

    transform: rotate(-8deg);

    box-shadow: 0 15px 40px rgba(0,0,0,0.35);
}

.image-badge strong {

    font-size: 10px;

    letter-spacing: 2px;
}

.image-badge span {

    font-family: "Playfair Display", serif;

    font-size: 30px;

    font-weight: 800;
}

.about-content h2 {

    margin-bottom: 30px;
}

.about-content > p {

    color: var(--gray);

    line-height: 1.9;

    margin-bottom: 15px;
}

.gold-line {

    width: 65px;

    height: 2px;

    background: var(--gold);

    margin: 35px 0;
}

.about-points {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 30px;
}

.about-points div {

    border-left: 1px solid rgba(214,163,84,0.45);

    padding-left: 18px;
}

.about-points span {

    color: var(--gold);

    font-size: 11px;

    font-weight: 700;
}

.about-points strong {

    display: block;

    margin: 8px 0;

    font-family: "Playfair Display", serif;

    font-size: 21px;
}

.about-points p {

    color: #82766e;

    font-size: 12px;

    line-height: 1.6;
}


/* =========================================
   ESPECIALIDADES
========================================= */

.specialties {

    padding: 130px 7%;

    background: var(--dark);

    text-align: center;
}

.section-heading {

    max-width: 720px;

    margin: auto auto 60px;
}

.section-heading h2 {

    margin-bottom: 20px;
}

.section-heading p {

    color: var(--gray);

    line-height: 1.7;
}

.specialty-grid {

    max-width: 1200px;

    margin: auto;

    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 18px;

    text-align: left;
}

.specialty-card {

    background: var(--dark-2);

    border: 1px solid var(--border);

    border-radius: 12px;

    overflow: hidden;

    transition: 0.4s;
}

.specialty-card:hover {

    transform: translateY(-12px);

    border-color: rgba(214,163,84,0.45);

    box-shadow:
        0 25px 60px rgba(0,0,0,0.35);
}

.specialty-image {

    height: 250px;

    background-size: cover;

    background-position: center;

    transition: 0.7s;
}

.specialty-card:hover .specialty-image {

    transform: scale(1.04);
}

.specialty-content {

    padding: 27px;
}

.specialty-content > span {

    color: var(--gold);

    font-size: 10px;

    font-weight: 700;
}

.specialty-content h3 {

    font-family: "Playfair Display", serif;

    font-size: 28px;

    margin: 10px 0;
}

.specialty-content p {

    color: #887b73;

    font-size: 13px;

    line-height: 1.7;

    margin-bottom: 20px;
}

.specialty-content a {

    color: var(--gold);

    font-size: 12px;

    font-weight: 700;

    transition: 0.3s;
}

.specialty-content a:hover {

    color: white;
}


/* =========================================
   DESTAQUE
========================================= */

.highlight {

    min-height: 650px;

    position: relative;

    display: flex;

    align-items: center;

    padding: 100px 8%;

    background-image:
        url("https://images.unsplash.com/photo-1579751626657-72bc17010498?auto=format&fit=crop&w=2200&q=90");

    background-size: cover;

    background-position: center;
}

.highlight-overlay {

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(20,8,4,0.94),
            rgba(20,8,4,0.62),
            rgba(20,8,4,0.35)
        );
}

.highlight-content {

    position: relative;

    z-index: 2;

    max-width: 650px;
}

.highlight-content h2 {

    margin-bottom: 25px;
}

.highlight-content p {

    max-width: 500px;

    color: #d0c3ba;

    line-height: 1.8;

    margin-bottom: 30px;
}


/* =========================================
   GALERIA
========================================= */

.gallery {

    max-width: 1300px;
}

.gallery-grid {

    display: grid;

    grid-template-columns: 2fr 1fr 1fr;

    grid-template-rows: 270px 270px;

    gap: 15px;
}

.gallery-item {

    overflow: hidden;

    border-radius: 10px;
}

.gallery-item.large {

    grid-row: span 2;
}

.gallery-item img {

    height: 100%;

    object-fit: cover;

    transition: 0.7s;
}

.gallery-item:hover img {

    transform: scale(1.08);
}

.gallery-note {

    color: #645951;

    font-size: 10px;

    margin-top: 18px;
}


/* =========================================
   PEDIDO
========================================= */

.order {

    padding: 120px 7%;

    background:
        radial-gradient(
            circle at center,
            #432517 0%,
            #1a0e09 60%,
            #120b08 100%
        );

    text-align: center;
}

.order-content {

    max-width: 720px;

    margin: auto;
}

.order h2 {

    margin-bottom: 25px;
}

.order p {

    color: var(--gray);

    line-height: 1.8;

    margin-bottom: 30px;
}


/* =========================================
   LOCALIZAÇÃO
========================================= */

.location {

    min-height: 600px;

    display: flex;

    align-items: center;

    padding: 100px 8%;

    background:
        linear-gradient(
            rgba(20,8,4,0.86),
            rgba(20,8,4,0.94)
        ),
        url("https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=2200&q=90");

    background-size: cover;

    background-position: center;
}

.location-content {

    max-width: 650px;
}

.location-content h2 {

    margin-bottom: 25px;
}

.location-content p {

    color: #d2c5bb;

    line-height: 2;

    margin-bottom: 30px;
}

.location-buttons {

    display: flex;

    gap: 12px;

    flex-wrap: wrap;
}

.dark-button {

    background: transparent;
}


/* =========================================
   CONTATO
========================================= */

.contact {

    text-align: center;
}

.contact h2 {

    margin-bottom: 20px;
}

.contact > p {

    color: #887c74;

    margin-bottom: 30px;
}

.contact-phone {

    display: inline-block;

    margin-bottom: 30px;

    font-family: "Playfair Display", serif;

    font-size: clamp(32px, 5vw, 55px);

    color: white;

    transition: 0.3s;
}

.contact-phone:hover {

    color: var(--gold);
}


/* =========================================
   FOOTER
========================================= */

footer {

    padding: 65px 7%;

    background: #0b0705;

    text-align: center;
}

.footer-logo {

    font-family: "Playfair Display", serif;

    font-size: 23px;

    font-weight: 800;

    margin-bottom: 12px;
}

.footer-logo span {

    color: var(--gold);
}

footer > p {

    color: #665a53;

    font-size: 12px;
}

.footer-links {

    display: flex;

    justify-content: center;

    gap: 25px;

    margin-top: 25px;
}

.footer-links a {

    color: #82766f;

    font-size: 12px;

    transition: 0.3s;
}

.footer-links a:hover {

    color: var(--gold);
}

.footer-line {

    width: 60px;

    height: 1px;

    background: #34251d;

    margin: 30px auto;
}

footer small {

    color: #493e38;

    font-size: 10px;
}


/* =========================================
   WHATSAPP
========================================= */

.whatsapp {

    position: fixed;

    right: 25px;
    bottom: 25px;

    width: 58px;
    height: 58px;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #25D366;

    border-radius: 50%;

    font-size: 25px;

    z-index: 998;

    box-shadow:
        0 10px 35px rgba(0,0,0,0.4);

    animation: whatsappPulse 2s infinite;

    transition: 0.3s;
}

.whatsapp:hover {

    transform: scale(1.1);

}


/* =========================================
   ANIMAÇÕES
========================================= */

@keyframes navbarDown {

    from {

        opacity: 0;

        transform: translateY(-25px);
    }

    to {

        opacity: 1;

        transform: translateY(0);
    }
}

@keyframes heroUp {

    from {

        opacity: 0;

        transform: translateY(45px);
    }

    to {

        opacity: 1;

        transform: translateY(0);
    }
}

@keyframes rotateSlow {

    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

@keyframes whatsappPulse {

    0% {
        box-shadow: 0 0 0 0 rgba(37,211,102,0.45);
    }

    70% {
        box-shadow: 0 0 0 15px rgba(37,211,102,0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(37,211,102,0);
    }
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 1000px) {

    nav {
        gap: 15px;
    }

    .specialty-grid {
        grid-template-columns: 1fr 1fr;
    }

    .about {
        grid-template-columns: 1fr;
        gap: 55px;
    }

    .about-image img {
        height: 500px;
    }

}


/* =========================================
   CELULAR
========================================= */

@media (max-width: 700px) {

    .navbar {

        height: 70px;

        padding: 0 5%;
    }

    nav {
        display: none;
    }

    .logo {
        font-size: 17px;
    }

    .nav-button {

        padding: 9px 15px;

        font-size: 11px;
    }


    /* HERO */

    .hero {

        min-height: 100svh;

        padding: 120px 7% 70px;

        background-position: 62% center;
    }

    .hero h1 {

        font-size: 54px;
    }

    .hero-content > p {

        font-size: 15px;
    }

    .hero-buttons {

        flex-direction: column;
    }

    .button {

        width: 100%;
    }

    .hero-info {

        gap: 25px;

        margin-top: 40px;
    }

    .hero-info strong {

        font-size: 20px;
    }

    .hero-decoration {

        display: none;
    }


    /* SEÇÕES */

    .section {

        padding: 90px 7%;
    }

    h2 {

        font-size: 43px;
    }


    /* SOBRE */

    .about-image img {

        height: 420px;
    }

    .about-points {

        grid-template-columns: 1fr;
    }


    /* ESPECIALIDADES */

    .specialties {

        padding: 90px 5%;
    }

    .specialty-grid {

        grid-template-columns: 1fr;
    }

    .specialty-image {

        height: 260px;
    }


    /* DESTAQUE */

    .highlight {

        min-height: 560px;

        padding: 90px 7%;
    }


    /* GALERIA */

    .gallery-grid {

        display: grid;

        grid-template-columns: 1fr 1fr;

        grid-template-rows: 220px 220px 220px;
    }

    .gallery-item.large {

        grid-column: span 2;

        grid-row: span 1;
    }


    /* LOCALIZAÇÃO */

    .location {

        min-height: 560px;

        padding: 90px 7%;
    }

    .location-buttons {

        flex-direction: column;
    }


    /* CONTATO */

    .contact-phone {

        font-size: 34px;
    }


    /* FOOTER */

    .footer-links {

        flex-wrap: wrap;

        gap: 15px;
    }


    /* WHATSAPP */

    .whatsapp {

        width: 54px;
        height: 54px;

        right: 18px;
        bottom: 18px;
    }

}
