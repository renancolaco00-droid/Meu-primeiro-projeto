

/* =========================
   CONFIGURAÇÕES
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "DM Sans", sans-serif;
    background: #0e0e0e;
    color: white;
}


/* =========================
   MENU
========================= */

.menu {
    position: fixed;
    top: 0;
    left: 0;

    width: 100%;

    padding: 20px 8%;

    display: flex;
    justify-content: space-between;
    align-items: center;

    background: rgba(14, 14, 14, 0.85);

    backdrop-filter: blur(10px);

    z-index: 1000;

    animation: aparecer 1s ease;
}

.logo {
    font-family: "Playfair Display", serif;

    font-size: 26px;
    font-weight: 700;
}

.logo span {
    color: #d6a354;
}

nav {
    display: flex;
    gap: 25px;
}

nav a {
    color: #ddd;

    text-decoration: none;

    font-size: 14px;

    transition: 0.3s;
}

nav a:hover {
    color: #d6a354;
}


/* =========================
   HERO
========================= */

.hero {

    min-height: 100vh;

    display: flex;
    align-items: center;

    padding: 120px 8%;

    background:
        linear-gradient(
            rgba(0,0,0,0.65),
            rgba(0,0,0,0.75)
        ),

        url("https://images.unsplash.com/photo-1515003197210-e0cd71810b5f?auto=format&fit=crop&w=1800&q=85");

    background-size: cover;
    background-position: center;

}

.hero-conteudo {
    max-width: 700px;

    animation: subir 1s ease;
}

.pequeno,
.titulo-pequeno {
    color: #d6a354;

    font-size: 13px;

    letter-spacing: 3px;

    font-weight: 700;

    margin-bottom: 20px;
}

.hero h1 {
    font-family: "Playfair Display", serif;

    font-size: clamp(48px, 8vw, 90px);

    line-height: 1;

    margin-bottom: 25px;
}

.hero h1 span,
h2 span {
    color: #d6a354;
}

.descricao {
    color: #ddd;

    font-size: 19px;

    max-width: 500px;

    margin-bottom: 35px;
}


/* =========================
   BOTÕES
========================= */

.botoes,
.contato-botoes {
    display: flex;

    gap: 15px;

    flex-wrap: wrap;
}

.botao {
    display: inline-block;

    padding: 15px 25px;

    border-radius: 8px;

    text-decoration: none;

    font-weight: 700;

    transition: 0.3s;
}

.principal {
    background: #d6a354;

    color: #111;
}

.principal:hover {
    transform: translateY(-5px);

    box-shadow: 0 10px 30px rgba(214,163,84,0.25);
}

.secundario {
    border: 1px solid #777;

    color: white;
}

.secundario:hover {
    background: white;

    color: #111;

    transform: translateY(-5px);
}


/* =========================
   SOBRE
========================= */

.sobre {
    max-width: 1200px;

    margin: auto;

    padding: 120px 8%;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 70px;

    align-items: center;
}

.imagem-sobre {
    overflow: hidden;

    border-radius: 15px;
}

.imagem-sobre img {
    width: 100%;

    display: block;

    transition: 0.6s;
}

.imagem-sobre:hover img {
    transform: scale(1.08);
}

.texto-sobre h2,
.servicos h2,
.horarios h2,
.contato h2 {
    font-family: "Playfair Display", serif;

    font-size: 50px;

    line-height: 1.1;

    margin-bottom: 25px;
}

.texto-sobre p {
    color: #bbb;

    margin-bottom: 20px;

    line-height: 1.8;
}


/* =========================
   SERVIÇOS
========================= */

.servicos {

    padding: 110px 8%;

    text-align: center;

    background: #151515;
}

.servicos h2 {
    margin-bottom: 50px;
}

.cards {

    max-width: 1100px;

    margin: auto;

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.card {

    background: #1d1d1d;

    padding: 40px 30px;

    border-radius: 15px;

    border: 1px solid #292929;

    transition: 0.4s;
}

.card:hover {

    transform: translateY(-10px);

    border-color: #d6a354;

}

.icone {

    font-size: 40px;

    margin-bottom: 20px;
}

.card h3 {

    font-size: 22px;

    margin-bottom: 15px;
}

.card p {

    color: #999;

    line-height: 1.6;
}


/* =========================
   HORÁRIOS
========================= */

.horarios {

    max-width: 1100px;

    margin: auto;

    padding: 120px 8%;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 60px;

    align-items: center;
}

.horario-card {

    background: #181818;

    padding: 15px 25px;

    border-radius: 15px;
}

.linha {

    display: flex;

    justify-content: space-between;

    gap: 20px;

    padding: 22px 0;

    border-bottom: 1px solid #333;
}

.linha:last-child {
    border-bottom: none;
}

.linha span {
    color: #aaa;
}

.linha strong {
    color: #d6a354;
}


/* =========================
   CONTATO
========================= */

.contato {

    padding: 120px 8%;

    text-align: center;

    background:

        linear-gradient(
            rgba(0,0,0,0.75),
            rgba(0,0,0,0.8)
        ),

        url("https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=1800&q=85");

    background-size: cover;

    background-position: center;
}

.contato h2 {
    margin-bottom: 20px;
}

.contato > p:not(.titulo-pequeno) {
    color: #ddd;

    line-height: 1.8;

    margin-bottom: 30px;
}

.contato-botoes {
    justify-content: center;
}


/* =========================
   RODAPÉ
========================= */

footer {

    padding: 40px 8%;

    background: #080808;

    text-align: center;
}

footer .logo {
    margin-bottom: 15px;
}

footer p {
    color: #777;

    font-size: 14px;

    margin-top: 5px;
}


/* =========================
   ANIMAÇÕES
========================= */

@keyframes aparecer {

    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

}

@keyframes subir {

    from {
        opacity: 0;

        transform: translateY(40px);
    }

    to {
        opacity: 1;

        transform: translateY(0);
    }

}


/* =========================
   CELULAR
========================= */

@media (max-width: 768px) {

    .menu {
        padding: 18px 5%;
    }

    nav {
        gap: 12px;
    }

    nav a {
        font-size: 12px;
    }

    .hero {
        padding: 120px 7% 80px;
    }

    .hero h1 {
        font-size: 52px;
    }

    .sobre {

        grid-template-columns: 1fr;

        padding: 80px 7%;

        gap: 40px;
    }

    .texto-sobre h2,
    .servicos h2,
    .horarios h2,
    .contato h2 {

        font-size: 40px;
    }

    .cards {

        grid-template-columns: 1fr;
    }

    .horarios {

        grid-template-columns: 1fr;

        padding: 80px 7%;

        gap: 35px;
    }

    .linha {

        flex-direction: column;

        gap: 5px;
    }

    .contato {

        padding: 90px 7%;
    }

}
